# SourceMark Enterprise Database Configuration
# Set your PostgreSQL credentials below to enable live PostgreSQL 16 persistence.

# Option 1: Full Connection URI
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD_HERE@127.0.0.1:5432/sourcemark_db

# Option 2: Individual Connection Parameters
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=sourcemark_db
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD_HERE

# Database Connection Pool Settings
DB_POOL_MAX=20
DATABASE_SSL=false

